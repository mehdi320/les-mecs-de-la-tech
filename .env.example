# Copier en .env.local et renseigner avant de lancer `npm run dev`.

# Chiffrement des secrets stockes en base (tokens OAuth, identifiants
# SMTP) — cf. src/shared/integration/secrets.ts. Generer une valeur
# aleatoire longue, jamais la valeur d'exemple ci-dessous.
APP_SECRET_KEY=change-moi-en-valeur-aleatoire-longue

# Chemin du fichier SQLite (optionnel, defaut : db/dev.db)
# DATABASE_PATH=./db/dev.db

# OAuth Google Workspace (Gmail API) — cf.
# src/modules/envoi/integration/connectors/google-workspace-connector.ts
# Non fournis dans l'environnement de developpement de cadrage.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/envoi/oauth/google/callback

# OAuth Microsoft 365 (Graph API) — cf.
# src/modules/envoi/integration/connectors/microsoft-365-connector.ts
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# MICROSOFT_REDIRECT_URI=http://localhost:3000/api/envoi/oauth/microsoft/callback

# Adresse utilisee comme MAIL FROM lors de la verification SMTP
# (module Verification) — cf.
# src/modules/verification/integration/smtp-checker.ts
# SMTP_CHECK_FROM_ADDRESS=verify@votre-domaine.com
